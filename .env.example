DATABASE_URL=postgresql://monitorame:monitorame@localhost:5432/monitorame
LOG_DATABASE_URL=postgresql://monitorame:monitorame@localhost:5432/monitorame
DATABASE_SSLMODE=disable
LOG_DATABASE_SSLMODE=disable
LOG_LEVEL=INFO

# PostgreSQL local iniciado por compose.yaml. Ao alterar usuario, senha, porta
# ou nomes dos databases, atualize tambem as duas URLs acima.
POSTGRES_USER=monitorame
POSTGRES_PASSWORD=monitorame
POSTGRES_DB=monitorame
POSTGRES_PORT=5432
API_PORT=8000
APP_IMAGE=monitorame-pipeline-api:local

TCE_CE_BASE_URL=https://api-dados-abertos.tce.ce.gov.br/sim
IBGE_LOCALIDADES_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
OPENCNPJ_BASE_URL=https://api.opencnpj.org
UF_PADRAO=CE

CODIGO_MUNICIPIO_TCE_PADRAO=010
