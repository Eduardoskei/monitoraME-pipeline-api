{
  "$defs": {
    "ElementAggregate": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "me_committed_net_cents": {
          "minimum": 0,
          "title": "Me Committed Net Cents",
          "type": "integer"
        },
        "share_of_me_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Share Of Me Rate"
        },
        "commitments_count": {
          "title": "Commitments Count",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "name",
        "me_committed_net_cents",
        "share_of_me_rate",
        "commitments_count"
      ],
      "title": "ElementAggregate",
      "type": "object"
    },
    "MonthlyPoint": {
      "additionalProperties": false,
      "properties": {
        "month": {
          "title": "Month",
          "type": "string"
        },
        "me_committed_net_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Me Committed Net Cents"
        },
        "previous_period_me_committed_net_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Period Me Committed Net Cents"
        },
        "coverage_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NO_DATA",
            "STALE"
          ],
          "title": "Coverage Status",
          "type": "string"
        }
      },
      "required": [
        "month",
        "me_committed_net_cents",
        "previous_period_me_committed_net_cents",
        "coverage_status"
      ],
      "title": "MonthlyPoint",
      "type": "object"
    },
    "MunicipalityAggregate": {
      "additionalProperties": false,
      "properties": {
        "ibge_code": {
          "pattern": "^[0-9]{7}$",
          "title": "Ibge Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "uf": {
          "title": "Uf",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Region"
        },
        "me_committed_net_cents": {
          "minimum": 0,
          "title": "Me Committed Net Cents",
          "type": "integer"
        },
        "share_of_state_me_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Share Of State Me Rate"
        },
        "local_me_purchases_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Me Purchases Rate"
        },
        "municipal_evasion_me_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Municipal Evasion Me Rate"
        },
        "commitments_count": {
          "title": "Commitments Count",
          "type": "integer"
        },
        "data_available": {
          "title": "Data Available",
          "type": "boolean"
        }
      },
      "required": [
        "ibge_code",
        "name",
        "uf",
        "region",
        "me_committed_net_cents",
        "share_of_state_me_rate",
        "local_me_purchases_rate",
        "municipal_evasion_me_rate",
        "commitments_count",
        "data_available"
      ],
      "title": "MunicipalityAggregate",
      "type": "object"
    },
    "OriginAggregate": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "BUYER_MUNICIPALITY",
            "OTHER_MUNICIPALITY_SAME_STATE",
            "OUT_OF_STATE",
            "UNKNOWN"
          ],
          "title": "Origin",
          "type": "string"
        },
        "me_committed_net_cents": {
          "minimum": 0,
          "title": "Me Committed Net Cents",
          "type": "integer"
        },
        "share_of_me_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Share Of Me Rate"
        }
      },
      "required": [
        "origin",
        "me_committed_net_cents",
        "share_of_me_rate"
      ],
      "title": "OriginAggregate",
      "type": "object"
    },
    "PublicFilters": {
      "additionalProperties": false,
      "properties": {
        "uf": {
          "default": "CE",
          "pattern": "^[A-Z]{2}$",
          "title": "Uf",
          "type": "string"
        },
        "municipality_ibge_code": {
          "anyOf": [
            {
              "pattern": "^[0-9]{7}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipality Ibge Code"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "expense_element_codes": {
          "items": {
            "pattern": "^[0-9]{6}$",
            "type": "string"
          },
          "title": "Expense Element Codes",
          "type": "array"
        },
        "supplier_origins": {
          "items": {
            "enum": [
              "BUYER_MUNICIPALITY",
              "OTHER_MUNICIPALITY_SAME_STATE",
              "OUT_OF_STATE",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "title": "Supplier Origins",
          "type": "array"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "PublicFilters",
      "type": "object"
    },
    "PublicKpis": {
      "additionalProperties": false,
      "properties": {
        "me_committed_net_cents": {
          "minimum": 0,
          "title": "Me Committed Net Cents",
          "type": "integer"
        },
        "me_share_of_all_purchases_rate": {
          "default": null,
          "title": "Me Share Of All Purchases Rate",
          "type": "null"
        },
        "me_share_of_all_purchases_status": {
          "const": "PENDING_PRODUCT_LEGAL_APPROVAL",
          "default": "PENDING_PRODUCT_LEGAL_APPROVAL",
          "title": "Me Share Of All Purchases Status",
          "type": "string"
        },
        "local_me_purchases_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Me Purchases Rate"
        },
        "municipal_evasion_me_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Municipal Evasion Me Rate"
        },
        "me_commitments_count": {
          "title": "Me Commitments Count",
          "type": "integer"
        },
        "identified_me_suppliers_count": {
          "title": "Identified Me Suppliers Count",
          "type": "integer"
        },
        "me_committed_net_change_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Me Committed Net Change Rate"
        },
        "me_share_change_pp": {
          "default": null,
          "title": "Me Share Change Pp",
          "type": "null"
        }
      },
      "required": [
        "me_committed_net_cents",
        "local_me_purchases_rate",
        "municipal_evasion_me_rate",
        "me_commitments_count",
        "identified_me_suppliers_count",
        "me_committed_net_change_rate"
      ],
      "title": "PublicKpis",
      "type": "object"
    },
    "PublicMeta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.9.1",
          "default": "0.9.1",
          "title": "Schema Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "data_as_of": {
          "format": "date",
          "title": "Data As Of",
          "type": "string"
        },
        "currency": {
          "const": "BRL",
          "default": "BRL",
          "title": "Currency",
          "type": "string"
        },
        "money_unit": {
          "const": "CENTS",
          "default": "CENTS",
          "title": "Money Unit",
          "type": "string"
        },
        "data_scope": {
          "const": "PUBLIC_ME_ONLY",
          "default": "PUBLIC_ME_ONLY",
          "title": "Data Scope",
          "type": "string"
        },
        "company_sizes": {
          "items": {
            "const": "ME",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Company Sizes",
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "source_timezone": {
          "const": "America/Fortaleza",
          "default": "America/Fortaleza",
          "title": "Source Timezone",
          "type": "string"
        },
        "is_stale": {
          "title": "Is Stale",
          "type": "boolean"
        },
        "last_successful_load_at": {
          "format": "date-time",
          "title": "Last Successful Load At",
          "type": "string"
        },
        "stale_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stale Reason"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "calculation_rule": {
          "title": "Calculation Rule",
          "type": "string"
        }
      },
      "required": [
        "generated_at",
        "data_as_of",
        "sources",
        "request_id",
        "is_stale",
        "last_successful_load_at",
        "stale_reason",
        "calculation_rule"
      ],
      "title": "PublicMeta",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "municipalities_with_data": {
          "title": "Municipalities With Data",
          "type": "integer"
        },
        "municipalities_in_scope": {
          "title": "Municipalities In Scope",
          "type": "integer"
        },
        "unknown_supplier_origin_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unknown Supplier Origin Rate"
        },
        "historical_size_classification_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Historical Size Classification Rate"
        },
        "is_partial_period": {
          "title": "Is Partial Period",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "municipalities_with_data",
        "municipalities_in_scope",
        "unknown_supplier_origin_rate",
        "historical_size_classification_rate",
        "is_partial_period",
        "warnings"
      ],
      "title": "Quality",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "response_type": {
      "const": "public_overview",
      "default": "public_overview",
      "title": "Response Type",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/PublicMeta"
    },
    "filters_applied": {
      "$ref": "#/$defs/PublicFilters"
    },
    "kpis": {
      "$ref": "#/$defs/PublicKpis"
    },
    "top_expense_elements": {
      "items": {
        "$ref": "#/$defs/ElementAggregate"
      },
      "title": "Top Expense Elements",
      "type": "array"
    },
    "monthly_series": {
      "items": {
        "$ref": "#/$defs/MonthlyPoint"
      },
      "title": "Monthly Series",
      "type": "array"
    },
    "expense_elements": {
      "items": {
        "$ref": "#/$defs/ElementAggregate"
      },
      "title": "Expense Elements",
      "type": "array"
    },
    "supplier_origins": {
      "items": {
        "$ref": "#/$defs/OriginAggregate"
      },
      "title": "Supplier Origins",
      "type": "array"
    },
    "municipalities": {
      "items": {
        "$ref": "#/$defs/MunicipalityAggregate"
      },
      "title": "Municipalities",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    }
  },
  "required": [
    "meta",
    "filters_applied",
    "kpis",
    "top_expense_elements",
    "monthly_series",
    "expense_elements",
    "supplier_origins",
    "municipalities",
    "quality"
  ],
  "title": "PublicOverviewResponse",
  "type": "object"
}
